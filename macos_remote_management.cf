###############################################################################
#
# On macOS hosts, gives each user in remote_users access to Remote Login (SSH)
# and Remote Management (Screen Sharing). It turns on sshd, adds the users to
# the SSH access group when access is restricted, grants them full Remote
# Management privileges, and limits Remote Management to those specified users.
#
# Generated by CFEngine Policy Builder from "macos remote management".
# Edits here are overwritten when the project is saved.
#
###############################################################################
body file control
{
  namespace => "macos_remote_management";
  evaluation_order => "top_down";
}

bundle common vars
{
  vars:
    default:darwin::
      # Remote users
      "remote_users" slist => { "craigcomstock" };
}

bundle agent main
{
  # Turn on Remote Login
  commands:
    default:darwin::
      "/bin/launchctl print system/com.openssh.sshd >/dev/null 2>&1 || /bin/launchctl load -w /System/Library/LaunchDaemons/ssh.plist"
        contain => default:in_shell,
        action => default:if_elapsed("60"),
        comment => "Loads sshd only when it isn't already; launchctl rather than systemsetup, which needs Full Disk Access on recent macOS.",
        classes => default:results("bundle", "turn_on_remote_login");

  # Allow SSH for remote users
  commands:
    default:darwin::
      "if /usr/bin/id -u $(macos_remote_management:vars.remote_users) >/dev/null 2>&1 && /usr/bin/dscl . -read /Groups/com.apple.access_ssh >/dev/null 2>&1 && ! /usr/sbin/dseditgroup -o checkmember -m $(macos_remote_management:vars.remote_users) com.apple.access_ssh >/dev/null 2>&1; then /usr/sbin/dseditgroup -o edit -a $(macos_remote_management:vars.remote_users) -t user com.apple.access_ssh; fi"
        contain => default:in_shell,
        action => default:if_elapsed("60"),
        comment => "Runs once per user in remote_users. The com.apple.access_ssh group only exists when SSH is limited to some users; without it every user may already log in, so nothing is changed.",
        if => "turn_on_remote_login_kept|turn_on_remote_login_repaired";

  # Grant Remote Management to remote users
  commands:
    default:darwin::
      "if /usr/bin/id -u $(macos_remote_management:vars.remote_users) >/dev/null 2>&1 && ! /usr/bin/dscl . -read /Users/$(macos_remote_management:vars.remote_users) naprivs 2>/dev/null | /usr/bin/grep -q -- -1073741569; then /System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/Resources/kickstart -configure -access -on -privs -all -users $(macos_remote_management:vars.remote_users); fi"
        contain => default:in_shell,
        action => default:if_elapsed("60"),
        comment => "Runs once per user in remote_users, skipping users that don't exist or already have all privileges (naprivs -1073741569).",
        classes => default:results(
          "bundle", "grant_remote_management_to_remote_users"
        );

  # Turn on Remote Management for specified users
  commands:
    default:darwin::
      "if ! /usr/bin/pgrep -q ARDAgent || [ \"$(const.dollar)(/usr/bin/defaults read /Library/Preferences/com.apple.RemoteManagement ARD_AllLocalUsers 2>/dev/null)\" != \"0\" ]; then /System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/Resources/kickstart -activate -configure -allowAccessFor -specifiedUsers -restart -agent -menu; fi"
        contain => default:in_shell,
        action => default:if_elapsed("60"),
        comment => "Starts the Remote Management agent (Screen Sharing included) and allows only the users granted privileges above, when it isn't already set that way.",
        if => "grant_remote_management_to_remote_users_kept|grant_remote_management_to_remote_users_repaired";
}
